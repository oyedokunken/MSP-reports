APP_NAME="Multi-Tenant Reporting Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (TimescaleDB with encryption)
DB_CONNECTION=pgsql
DB_HOST=timescaledb
DB_PORT=5432
DB_DATABASE=reporting
DB_USERNAME=reporting_user
DB_PASSWORD=reporting_password
DB_SSLMODE=require
# For production, use 'verify-full' with proper CA certificates
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/ca-certificate.crt

# Redis (Cache, Sessions, Queues)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Development - MailHog)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@reporting.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (for production file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite (Frontend)
VITE_APP_NAME="${APP_NAME}"

# Laravel MCP (AI Development Assistant)
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_READ_ONLY=false
MCP_ALLOW_DB_WRITES=false

# Multi-Tenancy
TENANT_STRICT_MODE=true

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Report Generation
REPORT_STORAGE_PATH=storage/app/reports
REPORT_RETENTION_DAYS=1095

# Integration Rate Limits (defaults)
INTEGRATION_RATE_LIMIT_PER_MINUTE=60
INTEGRATION_RATE_LIMIT_PER_HOUR=1000

# Historical Data
HISTORICAL_IMPORT_CHUNK_SIZE=1000
HISTORICAL_IMPORT_PRIORITY_DAYS=7

# Timezone
APP_TIMEZONE=Australia/Darwin
