{
  "platform": {
    "apiUrl": "https://reports.yourmsp.com/api",
    "apiKey": "",
    "timeout": 300
  },
  "sync": {
    "intervalMinutes": 240,
    "enableDeltaSync": true,
    "maxRetries": 3,
    "retryDelaySeconds": 30,
    "compressionEnabled": true
  },
  "activeDirectory": {
    "includeDisabledUsers": false,
    "includeDisabledComputers": false,
    "filterOUs": [],
    "excludeOUs": [],
    "excludeSystemGroups": true,
    "maxUsersPerSync": 10000,
    "maxGroupsPerSync": 5000
  },
  "licensing": {
    "enabled": true,
    "licenseGroups": [
      {
        "groupPattern": "*Office365*",
        "licenseName": "Microsoft 365",
        "licenseType": "SPLA",
        "costPerUser": 0
      },
      {
        "groupPattern": "*RDS*CAL*",
        "licenseName": "RDS CAL",
        "licenseType": "SPLA",
        "costPerUser": 0
      },
      {
        "groupPattern": "*Exchange*",
        "licenseName": "Exchange",
        "licenseType": "SPLA",
        "costPerUser": 0
      }
    ]
  },
  "logging": {
    "level": "Info",
    "logPath": "C:\\Logs\\MSPReports\\AD",
    "maxLogSizeMB": 100,
    "retentionDays": 30,
    "enableEventLog": true,
    "enableConsole": true
  },
  "advanced": {
    "batchSize": 500,
    "throttleDelayMs": 0,
    "useSecureCredentialStore": true,
    "validateSSL": true
  }
}
