[Unit]
Description=MSP Reports Laravel Scheduler
After=network.target redis.service postgresql.service
Wants=redis.service postgresql.service
PartOf=mspreports.target

[Service]
Type=simple
User=athena
Group=athena
WorkingDirectory=/var/www/mspreports/backend

# Laravel scheduler - runs scheduled tasks every minute
# This replaces the traditional cron entry: * * * * * php artisan schedule:run
ExecStart=/usr/bin/php artisan schedule:work

# Restart policy
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging
StandardOutput=append:/var/www/mspreports/backend/storage/logs/scheduler.log
StandardError=append:/var/www/mspreports/backend/storage/logs/scheduler.log

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/mspreports/backend/storage
ReadWritePaths=/var/www/mspreports/backend/bootstrap/cache

# Resource limits
MemoryMax=256M

[Install]
WantedBy=multi-user.target mspreports.target
