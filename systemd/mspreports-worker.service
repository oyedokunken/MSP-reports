[Unit]
Description=MSP Reports Laravel Queue Worker
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
User=athena
Group=athena
WorkingDirectory=/opt/mspreports/backend
ExecStart=/usr/bin/php artisan queue:work redis --queue=high,default,low --sleep=3 --tries=5 --max-time=3600 --timeout=900
Restart=always
RestartSec=5
StandardOutput=append:/opt/mspreports/backend/storage/logs/worker.log
StandardError=append:/opt/mspreports/backend/storage/logs/worker.log

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
