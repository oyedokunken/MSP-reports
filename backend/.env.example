# Application Configuration
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Performance
PHP_CLI_SERVER_WORKERS=4

# Security
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# For development, SQLite is recommended for simplicity
# For production, use PostgreSQL with TimescaleDB extension
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=reporting
# DB_USERNAME=postgres
# DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting & File Storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache Configuration
# For production, use Redis for better performance
CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

# Memcached (if using memcached for caching)
MEMCACHED_HOST=127.0.0.1

# Redis Configuration (Recommended for production)
# Used for: caching, queues, rate limiting, session storage
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="MSP Reports"

# AWS S3 Configuration (for file storage in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gotenberg PDF Generation Service
# Used for generating PDF reports
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=30
GOTENBERG_ENABLED=true

# Frontend Build Configuration
VITE_APP_NAME="${APP_NAME}"

# Rate Limiting Configuration (Optional)
# These can be overridden per integration in the UI
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

# LDAP/Active Directory Authentication Configuration
# Enable LDAP authentication by setting these values
LDAP_CONNECTION=default
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_USERNAME="cn=service-account,ou=ServiceAccounts,dc=example,dc=com"
LDAP_PASSWORD=secret
LDAP_BASE_DN="dc=example,dc=com"
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=true
LDAP_LOGGING=true
LDAP_CACHE=false

# LDAP User Attribute Mapping
LDAP_USER_ATTRIBUTE_USERNAME=samaccountname
LDAP_USER_ATTRIBUTE_EMAIL=mail
LDAP_USER_ATTRIBUTE_FIRSTNAME=givenname
LDAP_USER_ATTRIBUTE_LASTNAME=sn
LDAP_USER_ATTRIBUTE_DISPLAYNAME=displayname

# OAuth 2.0 (Microsoft 365) Configuration
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# SAML 2.0 Configuration
# SAML_ENABLED=false
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_SLO_URL=
# SAML_IDP_x509_CERT=

