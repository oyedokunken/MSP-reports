        {
          "name": "4. Get Computer Groups & Computers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "if (Array.isArray(data)) {",
                  "    data.forEach(function(section) {",
                  "        if (section.label === 'Computer Groups' && section.items && section.items.length > 0) {",
                  "            pm.collectionVariables.set('computer_group_id', section.items[0].value);",
                  "            console.log('Saved computer_group_id: ' + section.items[0].value);",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{api_token}}" },
