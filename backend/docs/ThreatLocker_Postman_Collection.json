  "item": [
    {
      "name": "Organizations",
      "item": [
        {
          "name": "1. Get Child Organizations (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "if (Array.isArray(data) && data.length > 0) {",
                  "    var orgId = data[0].organizationId || data[0].id;",
                  "    if (orgId) {",
                  "        pm.collectionVariables.set('organization_id', orgId);",
                  "        console.log('Saved organization_id: ' + orgId);",
                  "    }",
                  "}",
                  "",
                  "var pagination = pm.response.headers.get('Pagination');",
                  "if (pagination) {",
                  "    console.log('Pagination: ' + pagination);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{api_token}}" },
              { "key": "managedOrganizationId", "value": "{{managed_org_id}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pageSize\": 100,\n    \"pageNumber\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/Organization/OrganizationGetChildOrganizationsByParameters",
              "host": ["{{base_url}}"],
              "path": ["Organization", "OrganizationGetChildOrganizationsByParameters"]
            }
          }
        },
        {
          "name": "2. Get Organization Nav Tree",
          "event": [
            {
              "listen": "test",
