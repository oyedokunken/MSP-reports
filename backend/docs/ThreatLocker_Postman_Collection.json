            ],
            "url": {
              "raw": "{{base_url}}/ComputerGroup/ComputerGroupGetGroupAndComputer?osType=0&includeGlobal=true&includeAllPolicies=false&includeOrganizations=false&includeParentGroups=false&includeLoggedInObjects=false",
